#!/bin/bash
set -euo pipefail

for attempt in {1..20}; do
  if dnf install -y iptables-services%{ if enable_observability } amazon-cloudwatch-agent ethtool%{ endif }; then
    break
  fi
  if [[ "$attempt" -eq 20 ]]; then
    exit 1
  fi
  sleep 15
done

%{ if enable_observability }
install -d -m 0755 /opt/aws/amazon-cloudwatch-agent/etc
cat >/opt/aws/amazon-cloudwatch-agent/etc/billeif-nat.json <<'CLOUDWATCH_AGENT_CONFIG'
${cloudwatch_agent_config}
CLOUDWATCH_AGENT_CONFIG
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config \
  -m ec2 \
  -s \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/billeif-nat.json
systemctl is-active --quiet amazon-cloudwatch-agent
%{ endif }

cat >/etc/sysctl.d/99-billeif-nat.conf <<'SYSCTL'
net.ipv4.ip_forward=1
SYSCTL

cat >/usr/local/sbin/billeif-nat-configure <<'SCRIPT'
${forwarding_script}
SCRIPT
chmod 0755 /usr/local/sbin/billeif-nat-configure

cat >/etc/systemd/system/billeif-nat.service <<'UNIT'
[Unit]
Description=Billeif NAT forwarding
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/billeif-nat-configure
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
UNIT

cat >/etc/systemd/system/billeif-nat-watchdog.service <<'UNIT'
[Unit]
Description=Billeif NAT forwarding watchdog
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/billeif-nat-configure
UNIT

cat >/etc/systemd/system/billeif-nat-watchdog.timer <<'UNIT'
[Unit]
Description=Billeif NAT forwarding watchdog timer

[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
Unit=billeif-nat-watchdog.service

[Install]
WantedBy=timers.target
UNIT

systemctl daemon-reload
systemctl enable --now iptables
systemctl enable --now amazon-ssm-agent
systemctl enable --now billeif-nat.service billeif-nat-watchdog.timer
