# Environment
ENVIRONMENT=dev

# Server
SERVER_PORT=8080
SERVER_READ_TIMEOUT=30
SERVER_WRITE_TIMEOUT=30

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=invoice_user
DATABASE_PASSWORD=invoice_pass
DATABASE_NAME=invoice_db
DATABASE_SSL_MODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# AWS
AWS_REGION=us-east-1
AWS_LOCALSTACK=true
AWS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Cognito
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1
COGNITO_JWKS_REFRESH_RATE=600

# JWT
JWT_ACCESS_TOKEN_EXPIRY=1h
JWT_REFRESH_TOKEN_EXPIRY=720h

# S3
S3_BUCKET_LOGOS=business-logos
S3_BUCKET_INVOICES=invoices-pdf
S3_BUCKET_PRODUCTS=product-images
S3_BUCKET_EMAIL_SINK=email-sink

# SQS
SQS_INVOICE_QUEUE=invoice-processing-queue
SQS_PAYMENT_QUEUE=payment-processing-queue

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
