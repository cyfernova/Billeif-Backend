# ==================== Database ====================
DATABASE_URL=postgresql://user:password@localhost:5432/invoice_db
REDIS_URL=redis://localhost:6379

# ==================== Server ====================
PORT=8080
ENVIRONMENT=development
LOG_LEVEL=info
LOG_FORMAT=console
LOG_SAMPLING_INITIAL=0
LOG_SAMPLING_THEREAFTER=0
LOG_STACKTRACE_LEVEL=error
API_VERSION=v1

# ==================== Authentication ====================
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxx
JWT_SECRET=your-jwt-secret-key

# ==================== AWS ====================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=invoice-tracker-bucket

# ==================== Payment Gateway ====================
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxx

# ==================== NLP Configuration ====================
# Options: claude, gemini, rule-based
NLP_PROVIDER=claude
CLAUDE_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxx

# ==================== Agent Configuration ====================
A2A_SERVER_DOMAIN=api.yourdomain.com
WEBSOCKET_ENABLED=true
WEBSOCKET_MAX_CONNECTIONS=1000
AGENT_REGISTRY_ENABLED=true

# ==================== Monitoring ====================
SENTRY_DSN=https://xxxxxxxx@sentry.io/xxxxxxx
PROMETHEUS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ==================== Rate Limiting ====================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
AGENT_CREATION_LIMIT_PER_HOUR=10

# ==================== Security ====================
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
CORS_ENABLED=true
SSL_ENABLED=true
SSL_CERT_PATH=/etc/ssl/certs/cert.pem
SSL_KEY_PATH=/etc/ssl/private/key.pem
