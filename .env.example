# ==================== Database ====================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=invoice_db
DATABASE_USER=invoice_user
DATABASE_PASSWORD=invoice_pass
DATABASE_SSL_MODE=disable

# Optional: resolve DB credentials from SSM instead of plain env values
DATABASE_USER_SSM_PARAM=
DATABASE_PASSWORD_SSM_PARAM=

# ==================== Server ====================
ENVIRONMENT=development
LOG_LEVEL=info
LOG_FORMAT=console
LOG_SAMPLING_INITIAL=0
LOG_SAMPLING_THEREAFTER=0
LOG_STACKTRACE_LEVEL=error
API_VERSION=v1

# ==================== Authentication ====================
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxx
COGNITO_DOMAIN=invoice-backend-app.auth.us-east-1.amazoncognito.com
JWT_SECRET=your-jwt-secret-key

# ==================== AWS ====================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_ENDPOINT=
WEBSOCKET_API_ENDPOINT=
WEBSOCKET_CONNECTIONS_TABLE=invoice-backend-ws-connections

# ==================== AWS WAF Rate Limiting ====================
WAF_ENABLED=false
WAF_WEB_ACL_ARN=arn:aws:wafv2:us-east-1:123456789:regional/webacl/my-api/xxxxx
WAF_RATE_LIMIT_HEADER=X-Forwarded-For
WAF_BLOCKED_RESPONSE=rate limit exceeded. please try again later
WAF_HEADER_MATCH_COUNT=100

# ==================== Payment Gateway ====================
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxx
RAZORPAY_KEY_ID_SSM_PARAM=
RAZORPAY_KEY_SECRET_SSM_PARAM=
RAZORPAY_WEBHOOK_SECRET_SSM_PARAM=

# ==================== NLP Configuration ====================
# Options: claude, gemini, rule-based
NLP_PROVIDER=claude
CLAUDE_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxx

# ==================== Deepgram Speech-to-Text ====================
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxx
DEEPGRAM_VOICE_AGENT_URL=wss://agent.deepgram.com/v1/agent/converse
DEEPGRAM_VOICE_LISTEN_MODEL=nova-3
DEEPGRAM_VOICE_SPEAK_MODEL=aura-2-thalia-en
DEEPGRAM_VOICE_INPUT_ENCODING=linear16
DEEPGRAM_VOICE_INPUT_SAMPLE_RATE=24000
DEEPGRAM_VOICE_OUTPUT_ENCODING=linear16
DEEPGRAM_VOICE_OUTPUT_SAMPLE_RATE=24000

# ==================== Realtime Voice LLM ====================
DEEPSEEK_API_KEY=xxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ==================== DeepSeek LLM ====================
LLM_API_KEY=xxxxxxxxxxxxxxxxxx
LLM_API_URL=https://api.deepseek.com/chat/completions
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT=60

# ==================== Realtime Voice WebSocket ====================
VOICE_WS_MAX_SESSION_SECONDS=900
VOICE_WS_PING_INTERVAL_SECONDS=20
VOICE_WS_WRITE_TIMEOUT_SECONDS=5
VOICE_WS_MAX_FRAME_BYTES=32768
VOICE_WS_MAX_CONCURRENT_SESSIONS_PER_USER=1

# ==================== Agent Configuration ====================
A2A_SERVER_DOMAIN=api.yourdomain.com
WEBSOCKET_ENABLED=true
WEBSOCKET_MAX_CONNECTIONS=1000
AGENT_REGISTRY_ENABLED=true

# ==================== Monitoring ====================
SENTRY_DSN=https://xxxxxxxx@sentry.io/xxxxxxx
PROMETHEUS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ==================== Rate Limiting ====================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
AGENT_CREATION_LIMIT_PER_HOUR=10

# ==================== Security ====================
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
CORS_ENABLED=true
CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Optional: resolve encryption key from SSM
CREDENTIAL_ENCRYPTION_KEY_SSM_PARAM=
