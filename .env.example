# Server Configuration
SERVER_PORT=8080
SERVER_MODE=debug
SERVER_READ_TIMEOUT=60
SERVER_WRITE_TIMEOUT=60
SERVER_SHUTDOWN_TIMEOUT=10
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=invoice_user
DB_PASSWORD=invoice_password
DB_NAME=invoice_db
DB_SSLMODE=disable

# AWS / LocalStack Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_LOCALSTACK_ENDPOINT=http://localhost:4566

# Cognito Configuration (get from Terraform outputs)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_REGION=us-east-1

# DynamoDB Configuration
DYNAMODB_SESSIONS_TABLE=invoice-backend-sessions-development
DYNAMODB_PREFERENCES_TABLE=invoice-backend-preferences-development

# S3 Configuration
S3_PROFILE_PICTURES_BUCKET=invoice-backend-profile-pictures-development
S3_REGION=us-east-1

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production-min-32-chars
JWT_ACCESS_TOKEN_EXP=15
JWT_REFRESH_TOKEN_EXP=10080
JWT_ISSUER=invoice-backend

# Application Configuration
APP_ENVIRONMENT=development
APP_LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Auto Migration
AUTO_MIGRATE=false
