# Application
APP_ENV=development
APP_PORT=8080
APP_NAME=invoice-backend
LOG_LEVEL=debug

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566

# DynamoDB
DYNAMODB_ENDPOINT=http://localhost:4566
DYNAMODB_TABLE_INVOICES=invoice-storage-invoices
DYNAMODB_TABLE_CLIENTS=invoice-storage-clients

# S3
S3_ENDPOINT=http://localhost:4566
S3_BUCKET_INVOICES=invoice-storage-invoices
S3_BUCKET_LOGOS=invoice-storage-logos
S3_BUCKET_DOCUMENTS=invoice-storage-documents

# SES
SES_ENDPOINT=http://localhost:4566
SES_FROM_EMAIL=noreply@invoice.local
SES_VERIFIED_EMAIL=dev@example.com

# SNS
SNS_ENDPOINT=http://localhost:4566
SNS_TOPIC_NOTIFICATIONS=arn:aws:sns:us-east-1:000000000000:invoice-notifications
SNS_TOPIC_ALERTS=arn:aws:sns:us-east-1:000000000000:invoice-alerts

# SQS
SQS_ENDPOINT=http://localhost:4566
SQS_QUEUE_INVOICE_PROCESSING=invoice-processing
SQS_QUEUE_EMAIL=email-queue

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# PDF Generation
PDF_FONT_PATH=/assets/fonts/roboto.ttf
PDF_LOGO_HEIGHT=50
