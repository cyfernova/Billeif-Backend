# ==================== Database ====================
DATABASE_HOST=db.example.test
DATABASE_PORT=5432
DATABASE_NAME=invoice_db
DATABASE_USER=invoice_user
DATABASE_PASSWORD=invoice_pass
DATABASE_SSL_MODE=disable

# Lambda: non-secret host is read from SSM and RDS credentials from Secrets Manager.
DATABASE_HOST_SSM_PARAM=
DATABASE_SECRET_ARN=

# Optional: private RDS local tunnel. Leave DATABASE_HOST empty in .env.local
# to make `make run-local` use 127.0.0.1:RDS_LOCAL_PORT.
RDS_LOCAL_PORT=15432
RDS_TUNNEL_TARGET_ID=

# ==================== Server ====================
ENVIRONMENT=development
LOG_LEVEL=info
LOG_FORMAT=console
LOG_SAMPLING_INITIAL=0
LOG_SAMPLING_THEREAFTER=0
LOG_STACKTRACE_LEVEL=error
API_VERSION=v1

# ==================== Authentication ====================
COGNITO_USER_POOL_ID=your-cognito-user-pool-id
COGNITO_CLIENT_ID=your-cognito-client-id
COGNITO_DOMAIN=auth.example.com
JWT_SECRET=your-jwt-secret-key

# ==================== AWS ====================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_ENDPOINT=
WEBSOCKET_API_ENDPOINT=
WEBSOCKET_CONNECTIONS_TABLE=billeif-dev-ws-connections

# ==================== AgentCore Voice Session Control Plane ====================
# Routes are registered only when both the retained DynamoDB table and runtime ARN are set.
VOICE_SESSIONS_TABLE_NAME=
AGENTCORE_RUNTIME_ARN=
AGENTCORE_RUNTIME_QUALIFIER=PROD
VOICE_PROTOCOL_VERSION=1
VOICE_KVS_CHANNEL_COUNT=12
VOICE_SESSION_MAX_DURATION=55m
VOICE_SESSION_ROTATE_AFTER=52m
VOICE_SESSION_LEASE_DURATION=2m
VOICE_SESSION_IDEMPOTENCY_TTL=24h
VOICE_SESSION_LEASE_INDEX_NAME=gsi2
VOICE_GLOBAL_CAPACITY_LIMIT=100
VOICE_PER_USER_CAPACITY_LIMIT=1

# ==================== AWS WAF Rate Limiting ====================
WAF_ENABLED=false
WAF_WEB_ACL_ARN=arn:aws:wafv2:us-east-1:123456789:regional/webacl/my-api/xxxxx
WAF_RATE_LIMIT_HEADER=X-Forwarded-For
WAF_BLOCKED_RESPONSE=rate limit exceeded. please try again later
WAF_HEADER_MATCH_COUNT=100

# ==================== Payment Gateway ====================
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
RAZORPAY_SECRET_ARN=

# ==================== NLP Configuration ====================
# Options: claude, gemini, rule-based
NLP_PROVIDER=claude
CLAUDE_API_KEY=your-claude-api-key
GEMINI_API_KEY=your-gemini-api-key

# ==================== Sarvam Text-to-Speech ====================
SARVAM_API_KEY=your-sarvam-api-key
SARVAM_SECRET_ARN=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_TIMEOUT=60

# ==================== DeepSeek OpenAI-Compatible Provider ====================
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_SECRET_ARN=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ==================== LLM ====================
LLM_API_KEY=your-llm-api-key
LLM_SECRET_ARN=
LLM_API_URL=https://llm.example.test/chat/completions
LLM_MODEL=your-llm-model
LLM_TIMEOUT=60
EXA_API_KEY=your-exa-api-key
EXA_SECRET_ARN=
EXA_BASE_URL=https://api.exa.ai/search
EXA_TIMEOUT=12

# ==================== GSTIN Lookup ====================
GST_LOOKUP_BASE_URL=https://sheet.gstincheck.co.in/check/{api_key}/{gstin}
GST_LOOKUP_API_KEY=your-gst-lookup-api-key
GST_LOOKUP_SECRET_ARN=
GST_LOOKUP_TIMEOUT=15

# ==================== Agent Configuration ====================
A2A_SERVER_DOMAIN=api.example.com
WEBSOCKET_ENABLED=true
WEBSOCKET_MAX_CONNECTIONS=1000
AGENT_REGISTRY_ENABLED=true

# ==================== Monitoring ====================
SENTRY_DSN=https://public-key@sentry.example.test/project-id
PROMETHEUS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.test

# ==================== Rate Limiting ====================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
AGENT_CREATION_LIMIT_PER_HOUR=10

# ==================== Security ====================
ALLOWED_ORIGINS=https://app.example.com
CORS_ENABLED=true
CREDENTIAL_ENCRYPTION_KEY=base64-encoded-32-byte-key

# Lambda identifier for the runtime-only credential encryption key.
CREDENTIAL_ENCRYPTION_SECRET_ARN=
