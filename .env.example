# ==================== Database ====================
DATABASE_HOST=db.example.test
DATABASE_PORT=5432
DATABASE_NAME=invoice_db
DATABASE_USER=invoice_user
DATABASE_PASSWORD=invoice_pass
DATABASE_SSL_MODE=disable

# Optional: resolve DB connection values from SSM instead of plain env values
DATABASE_HOST_SSM_PARAM=
DATABASE_USER_SSM_PARAM=
DATABASE_PASSWORD_SSM_PARAM=

# Optional: private RDS local tunnel. Leave DATABASE_HOST empty in .env.local
# to make `make run-local` use 127.0.0.1:RDS_LOCAL_PORT.
RDS_LOCAL_PORT=15432
RDS_TUNNEL_TARGET_ID=

# ==================== Server ====================
ENVIRONMENT=development
LOG_LEVEL=info
LOG_FORMAT=console
LOG_SAMPLING_INITIAL=0
LOG_SAMPLING_THEREAFTER=0
LOG_STACKTRACE_LEVEL=error
API_VERSION=v1

# ==================== Authentication ====================
COGNITO_USER_POOL_ID=your-cognito-user-pool-id
COGNITO_CLIENT_ID=your-cognito-client-id
COGNITO_DOMAIN=auth.example.com
JWT_SECRET=your-jwt-secret-key

# ==================== AWS ====================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_ENDPOINT=
WEBSOCKET_API_ENDPOINT=
WEBSOCKET_CONNECTIONS_TABLE=invoice-backend-ws-connections

# ==================== AWS WAF Rate Limiting ====================
WAF_ENABLED=false
WAF_WEB_ACL_ARN=arn:aws:wafv2:us-east-1:123456789:regional/webacl/my-api/xxxxx
WAF_RATE_LIMIT_HEADER=X-Forwarded-For
WAF_BLOCKED_RESPONSE=rate limit exceeded. please try again later
WAF_HEADER_MATCH_COUNT=100

# ==================== Payment Gateway ====================
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
RAZORPAY_KEY_ID_SSM_PARAM=
RAZORPAY_KEY_SECRET_SSM_PARAM=
RAZORPAY_WEBHOOK_SECRET_SSM_PARAM=

# ==================== NLP Configuration ====================
# Options: claude, gemini, rule-based
NLP_PROVIDER=claude
CLAUDE_API_KEY=your-claude-api-key
GEMINI_API_KEY=your-gemini-api-key

# ==================== Deepgram Speech-to-Text ====================
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_VOICE_AGENT_URL=wss://agent.deepgram.com/v1/agent/converse
DEEPGRAM_VOICE_LISTEN_MODEL=nova-3
DEEPGRAM_VOICE_SPEAK_MODEL=aura-2-thalia-en
DEEPGRAM_VOICE_INPUT_ENCODING=linear16
DEEPGRAM_VOICE_INPUT_SAMPLE_RATE=24000
DEEPGRAM_VOICE_OUTPUT_ENCODING=linear16
DEEPGRAM_VOICE_OUTPUT_SAMPLE_RATE=24000

# ==================== Realtime Voice LLM ====================
DEEPSEEK_API_KEY=your-realtime-voice-llm-api-key
DEEPSEEK_BASE_URL=https://voice-llm.example.test/v1
DEEPSEEK_MODEL=your-realtime-voice-model

# ==================== LLM ====================
LLM_API_KEY=your-llm-api-key
LLM_API_URL=https://llm.example.test/chat/completions
LLM_MODEL=your-llm-model
LLM_TIMEOUT=60
EXA_API_KEY=your-exa-api-key
EXA_BASE_URL=https://api.exa.ai/search
EXA_TIMEOUT=12

# ==================== GSTIN Lookup ====================
GST_LOOKUP_BASE_URL=https://sheet.gstincheck.co.in/check/{api_key}/{gstin}
GST_LOOKUP_API_KEY=your-gst-lookup-api-key
GST_LOOKUP_TIMEOUT=15

# ==================== Realtime Voice WebSocket ====================
VOICE_WS_MAX_SESSION_SECONDS=900
VOICE_WS_PING_INTERVAL_SECONDS=20
VOICE_WS_WRITE_TIMEOUT_SECONDS=5
VOICE_WS_MAX_FRAME_BYTES=32768
VOICE_WS_MAX_CONCURRENT_SESSIONS_PER_USER=1
VOICE_WS_EVENT_POLL_INTERVAL_MS=100
VOICE_WS_EVENT_TTL_SECONDS=1800
VOICE_WS_MAX_OUTBOUND_CHUNK_BYTES=20000
VOICE_WS_PROVIDER_READY_TIMEOUT_SECONDS=15
VOICE_SESSIONS_TABLE_NAME=invoice-backend-voice-sessions
VOICE_SESSION_LAMBDA_FUNCTION_NAME=invoice-backend-voice-session
VOICE_SESSION_LAMBDA_MEMORY_SIZE=1024
VOICE_SESSION_LAMBDA_TIMEOUT_SECONDS=900
VOICE_SESSION_RESERVED_CONCURRENCY=5

# ==================== Agent Configuration ====================
A2A_SERVER_DOMAIN=api.example.com
WEBSOCKET_ENABLED=true
WEBSOCKET_MAX_CONNECTIONS=1000
AGENT_REGISTRY_ENABLED=true

# ==================== Monitoring ====================
SENTRY_DSN=https://public-key@sentry.example.test/project-id
PROMETHEUS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.test

# ==================== Rate Limiting ====================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
AGENT_CREATION_LIMIT_PER_HOUR=10

# ==================== Security ====================
ALLOWED_ORIGINS=https://app.example.com
CORS_ENABLED=true
CREDENTIAL_ENCRYPTION_KEY=base64-encoded-32-byte-key

# Optional: resolve encryption key from SSM
CREDENTIAL_ENCRYPTION_KEY_SSM_PARAM=
